<UserControl x:Class="SudokuSolver.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SudokuSolver"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance local:Game}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Внешний Border, чтобы нарисовать всей игровой доски -->
        <Border BorderBrush="Black" BorderThickness="5" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ItemsControl ItemsSource="{Binding Cells, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Привязываем количество строк и колонок к ViewModel, так как они тоже динамические -->
                        <UniformGrid Columns="{Binding DataContext.TotalDiameter, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                     Rows="{Binding DataContext.TotalDiameter, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <!--<DataTemplate>
                        -->
                    <!-- Ячейка -->
                    <!--
                        <Border BorderBrush="Black" 
                        BorderThickness="{Binding BorderThickness}" 
                        Width="40" Height="40">

                            <TextBlock Text="{Binding Value}" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               FontSize="16" 
                               FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        -->
                    <!-- Стандартный цвет фона -->
                    <!--
                                        <Setter Property="Background" Value="White"/>
                                        <Style.Triggers>
                                            -->
                    <!-- Условие: когда ваш bool-флаг равен true -->
                    <!--
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter Property="Background" Value="Red"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </DataTemplate>-->
                    <DataTemplate>
                        <!-- 1. Кнопка вместо обычного Border -->
                        <Button Command="{Binding DataContext.SelectCellCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    Background="Transparent">

                            <!-- Сбрасываем стандартный стиль кнопки Windows, оставляя только её поведение -->
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CellBorder" 
                                BorderBrush="Black" 
                                BorderThickness="{Binding BorderThickness}" 
                                Background="{TemplateBinding Background}"
                                Width="40" Height="40">

                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- 2. Триггер для изменения цвета при выделении -->
                                    <ControlTemplate.Triggers>
                                        <!-- Условие: когда ваш bool-флаг равен true -->
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter TargetName="CellBorder" Property="Background" Value="Red"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <!-- Подсвечиваем ячейку, например, нежно-голубым цветом -->
                                            <Setter TargetName="CellBorder" Property="Background" Value="#ADD8E6"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>

                            <!-- Содержимое ячейки Судоку -->
                            <TextBlock Text="{Binding Value}" FontSize="16" FontWeight="Bold"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <!--Кнопки выбора-->
        <ItemsControl ItemsSource="{Binding PossibleValues, Mode=OneWay}" Grid.Row="1">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding}" 
                            Command="{Binding DataContext.SetSelectedValueCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            FontSize="16" 
                            FontWeight="Bold"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
