<Window
    x:Class="SudokuSolver.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SudokuSolver"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    Title="Судоку"
    Width="872"
    Height="541"
    d:Height="450"
    d:Width="800"
    mc:Ignorable="d">
    <Window.DataContext>
        <local:Main />
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <!--  Меню  -->
        <StackPanel VerticalAlignment="Center" Orientation="Vertical">
            <StackPanel.Resources>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Margin" Value="3,10,3,0" />
                </Style>
            </StackPanel.Resources>
            <GroupBox Header="Новая игра">
                <StackPanel Orientation="Vertical">
                    <Label
                        Margin="0"
                        Padding="0"
                        Content="Высота" />
                    <xctk:IntegerUpDown Minimum="2" Value="{Binding NewGameHeight}" />
                    <Label
                        Margin="0"
                        Padding="0"
                        Content="Ширина" />
                    <xctk:IntegerUpDown
                        Grid.Row="1"
                        Minimum="2"
                        Value="{Binding NewGameWidth}" />
                    <Label
                        Margin="0"
                        Padding="0"
                        Content="Заполнение, %" />
                    <xctk:IntegerUpDown
                        Grid.Row="2"
                        Maximum="100"
                        Minimum="1"
                        Value="{Binding NewGameFillPercent}" />
                    <Button Command="{Binding NewGameCommand}" Content="Создать" />
                </StackPanel>
            </GroupBox>
            <StackPanel Orientation="Horizontal">
                <Button
                    Margin="0"
                    VerticalAlignment="Center"
                    Command="{Binding ValidateGameCommand}"
                    Content="Проверить" />
                <CheckBox
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    IsChecked="{Binding Game.AutoValidate}"
                    Content="Auto" />
            </StackPanel>
            <Button Command="{Binding SolveGameCommand}" Content="Решить" />
        </StackPanel>
        <!--  Игра  -->
        <local:GameView Grid.Column="1" DataContext="{Binding Game}" />
    </Grid>
</Window>
