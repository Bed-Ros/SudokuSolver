<Window x:Class="SudokuSolver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SudokuSolver"
        mc:Ignorable="d"
        Title="Судоку"
        d:Height="450" 
        d:Width="800">
    <Window.DataContext>
        <local:Main/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Vertical" VerticalAlignment="Center" >
            <StackPanel.Resources>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Margin" Value="3,10,3,0"/>
                </Style>
            </StackPanel.Resources>
            <Button Content="Новый" Command="{Binding NewGameCommand}"/>
            <Button Content="Проверить" Command="{Binding ValidateGameCommand}"/>
            <Button Content="Решить" Command="{Binding SolveGameCommand}"/>
        </StackPanel>
        <local:GameView Grid.Column="1" DataContext="{Binding Game}"/>
    </Grid>
</Window>
